;;; elpet-core-test.el --- Standalone core contracts -*- lexical-binding: t; -*-

(require 'ert)
(require 'elpet)

(defmacro elpet-test--with-pet (&rest body)
  "Run BODY with an isolated model and controllable clock."
  (declare (indent 0))
  `(let* ((elpet--instances (make-hash-table :test #'equal))
          (elpet--default-instance nil)
          (elpet-state-file nil)
          (elpet-test--time 100.0)
          (elpet--clock (lambda () elpet-test--time))
          (pet (elpet-create "test")))
     (unwind-protect (progn ,@body) (elpet-destroy pet))))

(defun elpet-test--event (pet source sequence kind &optional activity extras)
  "Submit an event to PET from SOURCE with SEQUENCE, KIND, ACTIVITY and EXTRAS."
  (elpet-emit
   (append (list :schema-version 1 :pet-id (elpet-instance-id pet)
                 :source-id source :source-epoch 0 :sequence sequence
                 :event-id (format "%s-%d" source sequence)
                 :kind kind :activity-id (or activity "work")) extras) pet))

(ert-deftest elpet-core-instance-isolation-and-idempotent-destroy ()
  (elpet-test--with-pet
   (let ((other (elpet-create "other")))
     (unwind-protect
         (progn
           (should-error (elpet-create "test") :type 'user-error)
           (elpet-register-source "build" nil pet)
           (elpet-test--event pet "build" 0 'started)
           (should (eq (plist-get (elpet-snapshot pet) :state) 'working))
           (should (eq (plist-get (elpet-snapshot other) :state) 'idle))
           (should (elpet-destroy pet))
           (should-not (elpet-destroy pet))
           (should-not (elpet-snapshot pet))
           (should (eq (plist-get (elpet-emit nil pet) :reason) 'inactive))
           (should (= (elpet-instance-generation pet) 1)))
       (elpet-destroy other)))))

(ert-deftest elpet-core-events-reject-duplicates-order-and-old-epochs ()
  (elpet-test--with-pet
   (elpet-register-source "build" nil pet)
   (should (plist-get (elpet-test--event pet "build" 3 'started) :ok))
   (should (eq (plist-get (elpet-test--event pet "build" 3 'started) :reason) 'duplicate))
   (should (eq (plist-get (elpet-test--event pet "build" 1 'finished) :reason) 'stale))
   (should (eq (plist-get (elpet-snapshot pet) :state) 'working))
   (elpet-register-source "build" '(:epoch 1) pet)
   (should (eq (plist-get (elpet-test--event pet "build" 4 'started) :reason) 'stale-epoch))
   (should (eq (plist-get (elpet-snapshot pet) :state) 'idle))))

(ert-deftest elpet-core-invalid-events-never-consume-sequences ()
  (elpet-test--with-pet
   (elpet-register-source "build" nil pet)
   (dolist (event '(42 (a . b) (:schema-version 2) nil))
     (should-not (plist-get (elpet-emit event pet) :ok)))
   (should-not (plist-get (elpet-test--event pet "build" 0 'say) :ok))
   (should-not (plist-get (elpet-test--event pet "build" 0 'state nil '(:state unknown)) :ok))
   (should (plist-get (elpet-test--event pet "build" 0 'started) :ok))))

(ert-deftest elpet-core-parallel-work-and-source-removal ()
  (elpet-test--with-pet
   (elpet-register-source "local-build" nil pet)
   (elpet-register-source "simulated-host" nil pet)
   (elpet-test--event pet "local-build" 0 'started "A")
   (elpet-test--event pet "local-build" 1 'started "B")
   (elpet-test--event pet "local-build" 2 'finished "A")
   (should (eq (plist-get (elpet-snapshot pet) :state) 'working))
   (elpet-test--event pet "simulated-host" 0 'waiting)
   (should (eq (plist-get (elpet-snapshot pet) :state) 'waiting))
   (elpet-unregister-source "simulated-host" pet)
   (should (eq (plist-get (elpet-snapshot pet) :state) 'working))
   (elpet-test--event pet "local-build" 3 'cancelled "B")
   (should (eq (plist-get (elpet-snapshot pet) :state) 'success))
   (setq elpet-test--time 111)
   (should (eq (plist-get (elpet-snapshot pet) :state) 'idle))))

(ert-deftest elpet-core-cancellation-and-baseline-do-not-celebrate ()
  (elpet-test--with-pet
   (elpet-register-source "host" nil pet)
   (elpet-test--event pet "host" 0 'finished nil '(:baseline t))
   (should (eq (plist-get (elpet-snapshot pet) :state) 'idle))
   (elpet-test--event pet "host" 1 'started "new")
   (elpet-test--event pet "host" 2 'cancelled "new")
   (should (eq (plist-get (elpet-snapshot pet) :state) 'idle))
   (elpet-test--event pet "host" 3 'started "new")
   (should (eq (plist-get (elpet-snapshot pet) :state) 'idle))))

(ert-deftest elpet-core-manual-expiry-restores-current-work ()
  (elpet-test--with-pet
   (elpet-register-source "build" nil pet)
   (elpet-test--event pet "build" 0 'started)
   (let ((id (elpet--request pet 'happy 3)))
     (should (eq (plist-get (elpet-snapshot pet) :state) 'happy))
     (setq elpet-test--time 104)
     (should (eq (plist-get (elpet-snapshot pet) :state) 'working))
     ;; A request that was never displayed expires as cancelled, not finished.
     (should (eq (plist-get (gethash id (elpet-instance-requests pet)) :status) 'cancelled)))))

(ert-deftest elpet-core-external-source-cannot-override-manual-control ()
  (elpet-test--with-pet
   (should-error (elpet-register-source "bad" '(:priority 999) pet) :type 'user-error)
   (elpet-register-source "host" '(:kinds (state waiting)) pet)
   (let ((id (elpet--request pet 'happy 5)))
     (elpet-test--event pet "host" 0 'state nil '(:state thinking))
     (should (eq (plist-get (elpet-snapshot pet) :state) 'happy))
     (elpet-cancel id pet)
     (should (eq (plist-get (elpet-snapshot pet) :state) 'thinking))
     (elpet-test--event pet "host" 1 'waiting)
     (should (eq (plist-get (elpet-snapshot pet) :state) 'waiting)))))

(ert-deftest elpet-core-messages-expire-replace-and-keep-full-history ()
  (elpet-test--with-pet
   (let ((elpet-history-limit 2)
         (text (make-string 1000 ?x)))
     (elpet-say "old" '(:replace-key status :seconds 2) pet)
     (elpet-say text '(:replace-key status :seconds 2) pet)
     (should (= (length (plist-get (elpet-snapshot pet) :messages)) 1))
     (should (equal (plist-get (car (plist-get (elpet-snapshot pet) :history)) :text) text))
     (elpet-say "last" nil pet)
     (should (= (length (plist-get (elpet-snapshot pet) :history)) 2))
     (setq elpet-test--time 120)
     (should-not (plist-get (elpet-snapshot pet) :messages))
     (should (= (length (plist-get (elpet-snapshot pet) :history)) 2)))))

(ert-deftest elpet-core-message-priority-and-permissions ()
  (elpet-test--with-pet
   (elpet-register-source "host" '(:kinds (say) :priority 40) pet)
   (should-error (elpet-say "oops" '(:source "missing") pet) :type 'user-error)
   (should-error (elpet-say "oops" '(:source "host" :priority 80) pet) :type 'user-error)
   (elpet-say "important" '(:source "host" :priority 40) pet)
   (elpet-say "ambient" nil pet)
   (should (equal (plist-get (elpet--best-message pet 100) :text) "important"))
   (elpet-unregister-source "host" pet)
   (should (equal (plist-get (elpet--best-message pet 100) :text) "ambient"))))

(ert-deftest elpet-core-snapshots-and-subscriber-data-are-detached ()
  (elpet-test--with-pet
   (elpet-say (copy-sequence "hello") nil pet)
   (let* ((snapshot (elpet-snapshot pet))
          (message (car (plist-get snapshot :messages))))
     (aset (plist-get snapshot :id) 0 ?X)
     (aset (plist-get message :text) 0 ?X)
     (should (equal (elpet-instance-id pet) "test"))
     (should (equal (plist-get (car (plist-get (elpet-snapshot pet) :messages)) :text) "hello")))
   (let (received)
     (let ((unsubscribe (elpet-subscribe (lambda (e) (push e received)) pet)))
       (elpet-subscribe (lambda (_) (error "expected test failure")) pet)
       (elpet-say "new" nil pet)
       (should (= (length received) 1))
       (funcall unsubscribe)
       (elpet-say "another" nil pet)
       (should (= (length received) 1))))))

(ert-deftest elpet-core-terminal-tables-are-bounded-over-time ()
  (elpet-test--with-pet
   (elpet-register-source "build" nil pet)
   (dotimes (index 300)
     (elpet-test--event pet "build" index 'finished (number-to-string index))
     (elpet--request pet 'happy 1)
     (cl-incf elpet-test--time 2)
     (elpet-snapshot pet))
   (should (< (hash-table-count (elpet-instance-requests pet)) 40))
   (should (< (hash-table-count (elpet-instance-activities pet)) 10))
   (should (<= (length (plist-get (gethash "build" (elpet-instance-sources pet)) :seen)) 128))))

(ert-deftest elpet-core-weighted-choice-and-repetition ()
  (let ((actions '((:name "a" :weight 3) (:name "b" :weight 1))))
    (dolist (draw '(0 1 2))
      (should (equal (plist-get (elpet--weighted-choice actions nil (lambda (_) draw)) :name) "a")))
    (should (equal (plist-get (elpet--weighted-choice actions nil (lambda (_) 3)) :name) "b"))
    (should (equal (plist-get (elpet--weighted-choice actions "a" (lambda (_) 0)) :name) "b"))))

(ert-deftest elpet-core-bundled-pack-and-missing-state-fallback ()
  (let* ((pack (elpet-load-pack (expand-file-name "pack.json" elpet--directory)))
         (elpet--pack pack))
    (should (file-readable-p (elpet-pack-fallback pack)))
    (should (equal (elpet-pack-id pack) "elpet-core"))
    (setf (elpet-pack-states pack) (assq-delete-all 'working (elpet-pack-states pack)))
    (should (elpet--pack-actions pack 'working))
    (setf (elpet-pack-states pack) nil)
    (should (equal (elpet--choose 'working) "__fallback__"))))

(ert-deftest elpet-core-pack-index-serves-assets-loops-and-completion ()
  (let* ((pack (elpet-load-pack (expand-file-name "pack.json" elpet--directory)))
         (index (elpet-pack-index pack))
         (elpet--pack pack)
         (elpet--animation "idle"))
    (should (hash-table-p index))
    (should (gethash "idle" index))
    (should (equal (plist-get (gethash "idle" index) :file)
                   (elpet--asset "idle")))
    (should (eq (plist-get (gethash "idle" index) :loop) t))
    (should (elpet--animation-loop-p))
    (should (equal (elpet--asset "__fallback__")
                   (elpet-pack-fallback pack)))
    ;; The built-in pack has one action per state and no catalog.
    (should (= (hash-table-count index) 8))
    (should-not (gethash "beiluoye-yanmo" index))
    (should (member "idle" (elpet--action-names)))))

(ert-deftest elpet-core-bubble-width-is-cached-by-wrap-key ()
  (let ((elpet-width 220)
        (elpet-bubble-max-lines 8)
        (elpet--parent nil)
        (elpet--bubble-max-width 0)
        (elpet--bubble-wrap-key nil)
        (elpet--bubble-lines nil)
        (elpet--bubble-all-lines nil)
        (elpet--bubble-offset 0))
    (elpet--wrap-text "first message")
    (let ((width elpet--bubble-max-width)
          (key elpet--bubble-wrap-key))
      (should (> width 0))
      ;; The same text and font reuse the cached width; a new text recomputes.
      (elpet--wrap-text "first message")
      (should (= width elpet--bubble-max-width))
      (should (equal key elpet--bubble-wrap-key))
      (elpet--wrap-text "a much longer second message that wraps")
      (should (> elpet--bubble-max-width width)))))

(ert-deftest elpet-core-text-pixels-uses-pixels-or-columns ()
  (let ((elpet--parent nil))
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil)))
      (should (= (elpet--text-pixels "abc") 21)))
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
              ((symbol-function 'string-pixel-width) (lambda (_) 42)))
      (should (= (elpet--text-pixels "abc") 42)))))

(ert-deftest elpet-core-pack-rejects-escaping-paths-and-symlinks ()
  (let ((root (make-temp-file "pet-pack-" t))
        (outside (make-temp-file "pet-outside-")))
    (unwind-protect
        (progn
          (should-error (elpet--pack-path root "../outside.gif") :type 'user-error)
          (should-error (elpet--pack-path root outside) :type 'user-error)
          (make-symbolic-link outside (expand-file-name "link.gif" root))
          (should-error (elpet--pack-path root "link.gif") :type 'user-error))
      (delete-directory root t) (delete-file outside))))

(ert-deftest elpet-core-position-roundtrip-resizes-and-clamps ()
  (let* ((record (append (elpet--position-record '(50 . 100) '(0 0 300 300) 100 100)
                         '(:pane 0)))
         (restored (elpet--restore-position record '((10 20 510 620)) 100 100)))
    (should (equal restored '(110 . 270)))
    (should (equal (elpet--restore-position record '((10 20 60 60)) 100 100) '(10 . 20)))))

(ert-deftest elpet-core-preferences-are-data-only-and-corruption-safe ()
  (let* ((directory (make-temp-file "pet-preferences-" t))
         (elpet-state-file (expand-file-name "state.json" directory)))
    (unwind-protect
        (progn
          (elpet--write-preferences
           '(:schema-version 1 :width 220 :reduced-motion :false
			     :position (:anchor "text-area" :x 0.5 :y 0.25 :pane 0)))
          (should (= (plist-get (elpet--read-preferences) :width) 220))
          (with-temp-file elpet-state-file (insert "not JSON"))
          (should-not (elpet--read-preferences))
          (elpet--write-preferences
           '(:schema-version 1 :position (:anchor "text-area" :x 500 :y 0 :pane 0)))
          (should-not (elpet--read-preferences)))
      (delete-directory directory t))))

(ert-deftest elpet-core-long-bubbles-fit-and-keep-preview-bounded ()
  (let ((elpet-bubble-max-lines 3))
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil)))
      (let ((lines (elpet--wrap-text (make-string 1000 ?x))))
        (should (= (length lines) 3))
        (should (string-suffix-p "…" (car (last lines))))
        (dolist (line lines) (should (<= (elpet--text-pixels line) 180)))))))

(ert-deftest elpet-core-reduced-motion-never-starts-animation ()
  (with-temp-buffer
    (let ((elpet-reduced-motion t)
          (elpet--buffer (current-buffer))
          (elpet--image nil)
          animated)
      (cl-letf (((symbol-function 'create-image)
                 (lambda (&rest _) '(image :type gif)))
                ((symbol-function 'insert-image)
                 (lambda (&rest _) (insert "pet")))
                ((symbol-function 'image-animate)
                 (lambda (&rest _) (setq animated t))))
        (elpet--play 'idle "idle")
        (should elpet--image)
        (should-not animated)))))

(ert-deftest elpet-core-bubble-scroll-clamps-and-streaming-keeps-position ()
  (let ((elpet-bubble-max-lines 3)
        (elpet--bubble-wrap-key nil) (elpet--bubble-offset 0)
        elpet--bubble-all-lines)
    (should (equal (elpet--wrap-text "one\ntwo\nthree\nfour\nfive")
                   '("one" "two" "three…")))
    (setq elpet--bubble-offset 999)
    (should (equal (elpet--wrap-text "one\ntwo\nthree\nfour\nfive")
                   '("three" "four" "five")))
    (should (= elpet--bubble-offset 2))
    (should (equal (elpet--wrap-text "one\ntwo\nthree\nfour\nfive\nsix")
                   '("three" "four" "five…")))
    (should (= elpet--bubble-offset 2))
    (should (equal (elpet--wrap-text "New message") '("New message")))
    (should (= elpet--bubble-offset 0))))

(ert-deftest elpet-core-bubbles-wrap-words-and-unbroken-text ()
  (cl-letf (((symbol-function 'elpet--text-pixels)
             (lambda (s) (* 10 (string-width s)))))
    (should (equal (elpet--text-lines "one two three four five")
                   '("one two three four" "five")))
    (let* ((text "Doing well, thanks for asking with a warm buffer and tea.")
           (lines (elpet--text-lines text)))
      (should (equal (mapconcat #'identity lines " ") text))
      (dolist (line lines) (should (<= (elpet--text-pixels line) 180))))
    (dolist (text '("一个很长的中文回复也应该能够自动换行而不会超出气泡宽度。"
                    "https://example.com/a-very-long-unbroken-path-123456789"))
      (let ((lines (elpet--text-lines text)))
        (should (equal (apply #'concat lines) text))
        (dolist (line lines) (should (<= (elpet--text-pixels line) 180)))))))



(ert-deftest elpet-core-reconnect-allocates-epochs-and-rejects-old-callbacks ()
  (elpet-test--with-pet
   (let ((first (elpet-register-source "host" nil pet)))
     (elpet-unregister-source "host" pet)
     (should (> (elpet-register-source "host" nil pet) first))
     (should (eq (plist-get (elpet-test--event pet "host" 99 'finished) :reason)
                 'stale-epoch))
     (should-error (elpet-register-source "manual" '(:kinds (state)) pet)
                   :type 'user-error))))

(ert-deftest elpet-core-default-catalog-preserves-all-gif-selection ()
  (let* ((elpet--pack (elpet-load-pack (expand-file-name "pack.json" elpet--directory)))
         (names (elpet--action-names)))
    (dolist (file (directory-files elpet-assets-directory t "\\.gif\\'"))
      (should (member (file-name-base file) names))
      (should (equal (elpet--asset (file-name-base file)) file)))))

(ert-deftest elpet-core-compilation-adapter-uses-public-source-lifecycle ()
  (elpet-test--with-pet
   (let* ((elpet--default-instance pet)
          (elpet-mode t)
          (elpet-follow-compilation t)
          (view (elpet--make-view))
          (first-buffer (generate-new-buffer " *pet-build-a*"))
          (last-buffer (generate-new-buffer " *pet-build-b*"))
          (a (make-pipe-process :name "pet-build-a" :buffer first-buffer :noquery t))
          (b (make-pipe-process :name "pet-build-b" :buffer last-buffer :noquery t)))
     (setf (elpet-instance-view pet) view)
     (unwind-protect
         (cl-letf (((symbol-function 'elpet--tick) #'ignore))
           (elpet--compilation-start a)
           (elpet--compilation-start b)
           (should (eq (plist-get (elpet-snapshot) :state) 'working))
           (elpet--compilation-finish first-buffer "finished\n")
           (should (eq (plist-get (elpet-snapshot) :state) 'working))
           (elpet--compilation-finish last-buffer "exited abnormally with code 1\n")
           (should (eq (plist-get (elpet-snapshot) :state) 'error))
           (setq elpet-follow-compilation nil)
           (elpet--with-view view (elpet--reconcile-compilations))
           (should (eq (plist-get (elpet-snapshot) :state) 'idle)))
       (delete-process a) (delete-process b)
       (kill-buffer first-buffer) (kill-buffer last-buffer)))))

(ert-deftest elpet-core-playback-receipts-and-repeat-cancellation ()
  (elpet-test--with-pet
   (let (events)
     (elpet-subscribe (lambda (event) (push event events)) pet)
     (let ((first (elpet--request pet 'happy 5)))
       (elpet--request pet 'idle 5)
       (should (cl-find-if (lambda (event)
                             (and (equal (plist-get event :id) first)
                                  (eq (plist-get event :status) 'cancelled))) events))
       (let ((count (length events)))
         (elpet-cancel first pet)
         (elpet-cancel first pet)
         (should (= count (length events))))))))

