;;; elpet-chat-test.el --- Pet chat lifecycle contracts -*- lexical-binding: t; -*-

(require 'ert)
(require 'elpet-chat)

(defmacro elpet-chat-test--with-session (&rest body)
  "Run BODY in an isolated conversation with a controlled transport."
  (declare (indent 0))
  `(elpet-test--with-pet
    (let ((elpet--default-instance pet)
          (elpet-chat--buffer nil) (elpet-chat--buffers nil)
          calls aborted)
      (cl-progv '(gptel-backend gptel-model) '(configured-backend configured-model)
        (save-window-excursion
          (cl-letf (((symbol-function 'elpet-chat--require-gptel) #'ignore)
                    ((symbol-function 'gptel-request)
                     (lambda (prompt &rest args)
                       (push (cons prompt args) calls)))
                    ((symbol-function 'gptel-abort)
                     (lambda (buffer) (push buffer aborted))))
            (unwind-protect
                (progn (elpet-chat) ,@body)
              (when (buffer-live-p elpet-chat--buffer)
                (kill-buffer elpet-chat--buffer)))))))))

(defun elpet-chat-test--reply (call response &optional info)
  "Deliver RESPONSE and INFO to the callback captured in CALL."
  (funcall (plist-get (cdr call) :callback) response info))

(ert-deftest elpet-chat-opening-is-explicit-and-isolated ()
  (elpet-chat-test--with-session
   (should-not calls)
   (should (eq gptel-backend 'configured-backend))
   (should (eq gptel-model 'configured-model))
   (elpet-chat-set-persona "A quiet owl")
   (should (equal elpet-chat--persona "A quiet owl"))
   (should-not (equal elpet-chat-persona "A quiet owl"))
   (insert "Hello")
   (elpet-chat-send)
   (should (equal (caar calls) '("Hello")))
   (should (equal (plist-get (cdar calls) :system) "A quiet owl"))
   (should (eq (plist-get (cdar calls) :buffer) (current-buffer)))
   (should-error (elpet-chat-send) :type 'user-error)))

(ert-deftest elpet-chat-stream-lifecycle-and-bounded-previews ()
  (elpet-chat-test--with-session
   (insert "Hello") (elpet-chat-send)
   (let ((request elpet-chat--active))
     (setq elpet-test--time 1000.0)
     (should (eq (plist-get (elpet-snapshot pet) :state) 'thinking))
     (elpet-chat-test--reply (car calls) '(reasoning . "private") '(:stream t))
     (dotimes (_ 20) (elpet-chat-test--reply (car calls) "Hi " '(:stream t)))
     (should (timerp (elpet-chat--request-timer request)))
     (cancel-timer (elpet-chat--request-timer request))
     (elpet-chat--preview request)
     (should (= (length (elpet-instance-messages pet)) 1))
     (should-not (elpet-instance-history pet))
     (should-not (string-match-p "private" (buffer-string)))
     (elpet-chat-test--reply (car calls) t)
     (should-not elpet-chat--active)
     (should-not (elpet-chat--request-timer request))
     (should (= (length elpet-chat--turns) 2))
     (should (= (length (elpet-instance-history pet)) 1))
     (should (eq (plist-get (elpet-snapshot pet) :state) 'success))
     (should (eq (plist-get (car (elpet-instance-messages pet)) :action)
                 'elpet-chat))
     (should (string-empty-p (elpet-chat--draft)))
     (should-error (let ((inhibit-read-only nil)) (goto-char (point-min)) (insert "x")))
     (goto-char (point-max)) (insert "Next"))))

(ert-deftest elpet-chat-nonstream-fallback-preserves-role-order ()
  (elpet-chat-test--with-session
   (insert "One") (elpet-chat-send)
   (elpet-chat-test--reply (car calls) "First reply" '(:status "200"))
   (should-not elpet-chat--active)
   (insert "Two") (elpet-chat-send)
   (should (equal (caar calls) '("One" "First reply" "Two")))
   (elpet-chat-test--reply (car calls) "Second reply")
   (should (= (length elpet-chat--turns) 4))))

(ert-deftest elpet-chat-cancel-and-retry-ignore-late-callbacks ()
  (elpet-chat-test--with-session
   (insert "Hello") (elpet-chat-send)
   (let ((old (car calls)) (buffer (current-buffer)))
     (elpet-chat-test--reply old "Partial" '(:stream t))
     (elpet-chat-stop)
     (should (equal aborted (list buffer)))
     (should (equal (elpet-chat--draft) "Hello"))
     (should-not elpet-chat--turns)
     (should-not (elpet-instance-messages pet))
     (elpet-chat-retry)
     (should (equal (caar calls) '("Hello")))
     (elpet-chat-test--reply old "Stale")
     (elpet-chat-test--reply old t)
     (should elpet-chat--active)
     (should-not (string-match-p "Stale" (buffer-string)))
     (elpet-chat-test--reply (car calls) "Fresh")
     (should (equal elpet-chat--turns '("Hello" "Fresh")))
     (should (= (length (elpet-instance-history pet)) 1)))))

(ert-deftest elpet-chat-error-keeps-editable-draft ()
  (elpet-chat-test--with-session
   (insert "Original") (elpet-chat-send)
   (elpet-chat-test--reply (car calls) nil '(:error "Offline"))
   (should (eq (plist-get (elpet-snapshot pet) :state) 'error))
   (should (equal (elpet-chat--draft) "Original"))
   (delete-region elpet-chat--input (point-max)) (insert "Edited")
   (elpet-chat-retry)
   (should (equal (caar calls) '("Edited")))
   (elpet-chat-test--reply (car calls) "Fixed")
   (should-not (string-match-p "Offline" (buffer-string)))))

(ert-deftest elpet-chat-synchronous-error-and-empty-response ()
  (elpet-chat-test--with-session
   (insert "Test")
   (cl-letf (((symbol-function 'gptel-request) (lambda (&rest _) (error "No key"))))
     (elpet-chat-send))
   (should-not elpet-chat--active)
   (should (equal (elpet-chat--request-error elpet-chat--last) "No key"))
   (elpet-chat-retry)
   (elpet-chat-test--reply (car calls) t)
   (should (equal (elpet-chat--request-error elpet-chat--last) "Empty response"))
   (should-not elpet-chat--turns)))

(ert-deftest elpet-chat-pet-destruction-cancels-and-can-reattach ()
  (elpet-chat-test--with-session
   (insert "Hello") (elpet-chat-send)
   (let ((old (car calls)) (new (elpet-create "replacement")))
     (unwind-protect
         (progn
           (elpet-destroy pet)
           (should-not elpet-chat--active)
           (should-not elpet-chat--pet)
           (setq elpet--default-instance new)
           (elpet-chat-retry)
           (elpet-chat-test--reply old "Old")
           (should (eq (plist-get (elpet-snapshot new) :state) 'thinking))
           (elpet-chat-test--reply (car calls) "New")
           (should (equal elpet-chat--turns '("Hello" "New"))))
       (elpet-destroy new)))))

(ert-deftest elpet-chat-buffer-kill-releases-source-and-request ()
  (elpet-chat-test--with-session
   (insert "Hello") (elpet-chat-send)
   (let ((old (car calls)) (buffer (current-buffer)) (source elpet-chat--source))
     (kill-buffer buffer)
     (should (equal aborted (list buffer)))
     (should-not (gethash source (elpet-instance-sources pet)))
     (should-not elpet-chat--buffers)
     (elpet-chat-test--reply old "Late")
     (should-not (elpet-instance-history pet)))))

(ert-deftest elpet-chat-background-replies-never-select-a-window ()
  (elpet-chat-test--with-session
   (insert "Hello") (elpet-chat-send)
   (let ((callback (car calls)))
     (with-temp-buffer
       (switch-to-buffer (current-buffer))
       (let ((buffer (current-buffer)) (window (selected-window)))
         (elpet-chat-test--reply callback "Hi")
         (should (eq (current-buffer) buffer))
         (should (eq (selected-window) window))
         (should (eq (window-buffer window) buffer)))))))

(ert-deftest elpet-chat-save-and-restore-json-without-sending ()
  (elpet-chat-test--with-session
   (let ((file (make-temp-file "pet-chat-")))
     (unwind-protect
         (progn
           (insert "你好") (elpet-chat-send)
           (elpet-chat-test--reply (car calls) "Hello")
           (insert "Unsent draft")
           (elpet-chat-set-persona "Be an owl")
           (elpet-chat-save file)
           (setq elpet-chat--turns nil elpet-chat--persona "Other")
           (elpet-chat-open file)
           (should (equal elpet-chat--turns '("你好" "Hello")))
           (should (equal (elpet-chat--draft) "Unsent draft"))
           (should (equal elpet-chat--persona "Be an owl"))
           (should (= (length calls) 1))
           (with-temp-file file (insert "{\"schema-version\":1,\"turns\":[\"odd\"]}"))
           (should-error (elpet-chat-open file) :type 'user-error)
           (should (equal elpet-chat--turns '("你好" "Hello"))))
       (delete-file file)))))

(ert-deftest elpet-chat-markdown-renders-without-changing-model-context ()
  (skip-unless (require 'markdown-mode nil t))
  (elpet-chat-test--with-session
   (should (derived-mode-p 'markdown-mode))
   (let ((reply "## Example\n\nA **bold** word and [link](https://example.com).\n\n```elisp\n(message \"Hello\")\n```"))
     (insert "Explain") (elpet-chat-send)
     ;; A fence may arrive split across chunks.
     (elpet-chat-test--reply (car calls) (substring reply 0 70) '(:stream t))
     (elpet-chat-test--reply (car calls) (substring reply 70) '(:stream t))
     (elpet-chat-test--reply (car calls) t)
     (font-lock-ensure)
     (save-excursion
       (goto-char (point-min)) (search-forward "Example")
       (should (get-text-property (1- (point)) 'face))
       (search-forward "bold")
       (should (get-text-property (1- (point)) 'face))
       (search-forward "message")
       (should (get-text-property (1- (point)) 'face)))
     (elpet-chat-toggle-markup)
     (should-not markdown-hide-markup)
     (should (equal (cadr elpet-chat--turns) reply))
     (goto-char (point-max)) (insert "Next") (elpet-chat-send)
     (should (equal (caar calls) (list "Explain" reply "Next"))))))

(ert-deftest elpet-chat-quit-and-disable-release-inflight-request ()
  (elpet-chat-test--with-session
   (insert "Hello")
   (cl-letf (((symbol-function 'gptel-request) (lambda (&rest _) (signal 'quit nil))))
     (elpet-chat-send))
   (should-not elpet-chat--active)
   (should (equal (elpet-chat--draft) "Hello"))
   (elpet-chat-retry)
   (elpet-chat-mode -1)
   (should-not elpet-chat--active)
   (should-not elpet-chat--pet)
   (should-not elpet-chat--buffers)
   (elpet-chat)
   (should elpet-chat-mode)
   (should elpet-chat--pet)
   (elpet-chat-send)
   (elpet-chat-test--reply (car calls) "Back")
   (should (equal elpet-chat--turns '("Hello" "Back")))))

(defun elpet-chat-test--label-at (position)
  "Return the displayed role label anchored at POSITION, if any."
  (when-let* ((overlay (cl-find-if
                       (lambda (item) (overlay-get item 'elpet-chat-role))
                       (overlays-in position position))))
    (cadr (get-text-property 0 'display (overlay-get overlay 'before-string)))))

(ert-deftest elpet-chat-presentation-keeps-draft-boundaries-clean ()
  (elpet-chat-test--with-session
   (let ((draft "A **small** question\nwith a second line."))
     (should (equal (elpet-chat-test--label-at elpet-chat--input) " YOU"))
     (should (= (marker-position elpet-chat--input) (point-max)))
     (should-not (marker-insertion-type elpet-chat--input))
     (insert draft)
     (font-lock-ensure)
     (dolist (property '(display invisible read-only font-lock-face category))
       (should-not (get-text-property elpet-chat--input property)))
     (should (equal (elpet-chat--draft) draft))
     (should-error (delete-region (1- elpet-chat--input) (point-max))
                   :type 'text-read-only)
     (delete-region elpet-chat--input (point-max))
     (insert draft)
     (elpet-chat-send)
     (should (equal (caar calls) (list draft)))
     (should-not (text-properties-at 0 (caar (car calls))))
     (should-not (string-match-p "^ Message" (buffer-string)))
     (elpet-chat-test--reply (car calls) "A clean reply.")
     (save-excursion
       (goto-char (point-min))
       (search-forward draft)
       (should (equal (elpet-chat-test--label-at (- (point) (length draft))) " YOU 01"))
       (search-forward "A clean reply.")
       (should (equal (elpet-chat-test--label-at (- (point) 14)) " PET 01")))
     (should (string-match-p "configured-model  /  1 exchange" (buffer-string)))
     (should (equal elpet-chat--turns (list draft "A clean reply.")))
     (should (string-empty-p (elpet-chat--draft)))
     (insert "Next")
     (should (equal (elpet-chat--draft) "Next")))))

(ert-deftest elpet-chat-header-reflects-request-lifecycle ()
  (elpet-chat-test--with-session
   (should (string-match-p "Ready" (apply #'concat (elpet-chat--header-line))))
   (insert "Hello") (elpet-chat-send)
   (should (string-match-p "Responding"
                           (apply #'concat (elpet-chat--header-line))))
   (elpet-chat-stop)
   (should (string-match-p "Stopped"
                           (apply #'concat (elpet-chat--header-line))))
   (elpet-chat-retry)
   (elpet-chat-test--reply (car calls) nil '(:error "Offline"))
   (should (string-match-p "Needs attention"
                           (apply #'concat (elpet-chat--header-line))))
   (should (string-match-p "Could not finish the reply\nOffline" (buffer-string)))
   (elpet-chat-retry)
   (elpet-chat-test--reply (car calls) "Back")
   (should (string-match-p "Ready" (apply #'concat (elpet-chat--header-line))))))

(ert-deftest elpet-chat-presentation-is-local-and-reversible ()
  (with-temp-buffer
    (text-mode)
    (setq-local header-line-format "Original" mode-line-format "Original mode line"
                line-spacing 0.5 left-margin-width 4 display-line-numbers t)
    (let ((right-local (local-variable-p 'right-margin-width))
          (right right-margin-width))
      (elpet-chat-mode 1)
      (elpet-chat-mode 1)
      (should (= left-margin-width 9))
      (should (= right-margin-width 2))
      (should-not display-line-numbers)
      (should visual-line-mode)
      (elpet-chat-mode -1)
      (should (equal header-line-format "Original"))
      (should (equal mode-line-format "Original mode line"))
      (should (= line-spacing 0.5))
      (should (= left-margin-width 4))
      (should display-line-numbers)
      (should-not visual-line-mode)
      (should (eq (local-variable-p 'right-margin-width) right-local))
      (should (equal right-margin-width right))
      (should-not elpet-chat--appearance))))

(ert-deftest elpet-chat-presentation-without-optional-packages ()
  (let ((original-require (symbol-function 'require)))
    (cl-letf (((symbol-function 'require)
               (lambda (feature &rest args)
                 (unless (memq feature '(markdown-mode gptel))
                   (apply original-require feature args)))))
      (with-temp-buffer
        (elpet-chat--setup)
        (should (derived-mode-p 'text-mode))
        (setq elpet-chat--turns '("Question" "Answer"))
        (elpet-chat--render "A draft")
        (font-lock-ensure)
        (should (eq (get-text-property 2 'font-lock-face) 'elpet-chat-title))
        (goto-char (point-min))
        (search-forward "Question")
        (should (equal (elpet-chat-test--label-at (- (point) 8)) " YOU 01"))
        (should (equal (elpet-chat--draft) "A draft"))
        (elpet-chat-mode -1)))))

(ert-deftest elpet-chat-stream-preserves-reading-window ()
  (elpet-chat-test--with-session
   (insert "Hello") (elpet-chat-send)
   (let* ((following (selected-window))
          (reading (split-window-below))
          (buffer (current-buffer))
          (start (point-min)))
     (set-window-buffer reading buffer)
     (set-window-point following (point-max))
     (set-window-point reading start)
     (elpet-chat-test--reply (car calls) "First " '(:stream t))
     (elpet-chat-test--reply (car calls) "second." '(:stream t))
     (should (eq (selected-window) following))
     (should (= (window-point reading) start))
     (should (= (window-point following) (point-max)))
     (should (equal (elpet-chat--request-response elpet-chat--active)
                    "First second."))
     (elpet-chat-stop)
     (should (equal (elpet-chat--draft) "Hello"))
     (should (string-match-p "Reply stopped" (buffer-string))))))

(ert-deftest elpet-chat-presentation-restores-window-specific-margins ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (setq-local left-margin-width 1 right-margin-width 1)
      (set-window-margins (selected-window) 5 6)
      (elpet-chat-mode -1)
      (should (equal (window-margins) '(5 . 6)))
      (elpet-chat-mode 1)
      (elpet-chat-mode 1)
      (should (equal (window-margins) '(9 . 2)))
      (elpet-chat-mode -1)
      (should (equal (window-margins) '(5 . 6)))
      (should-not elpet-chat--window-margins)
      (elpet-chat-mode -1)
      (should (equal (window-margins) '(5 . 6))))))

(ert-deftest elpet-chat-role-labels-share-the-first-content-line ()
  (elpet-chat-test--with-session
   (let ((reply "## Heading\n\nA **formatted** reply."))
     (insert "Hello")
     (elpet-chat-send)
     (let ((start (point-max)))
       (should (equal (elpet-chat-test--label-at start) " PET 01"))
       (elpet-chat-test--reply (car calls) "## Hea" '(:stream t))
       (elpet-chat-test--reply (car calls) "ding\n\nA **formatted** reply." '(:stream t))
       (font-lock-ensure)
       (should (equal (elpet-chat-test--label-at start) " PET 01"))
       (should (equal (buffer-substring-no-properties start (point-max)) reply)))
     (elpet-chat-test--reply (car calls) t)
     (dotimes (_ 3)
       (elpet-chat--render ""))
     (font-lock-ensure)
     (should (= (length (cl-remove-if-not
                        (lambda (overlay) (overlay-get overlay 'elpet-chat-role))
                        (overlays-in (point-min) (point-max)))) 3))
     (should (string-match-p "Hello\n\n## Heading" (buffer-string)))
     (let ((case-fold-search nil))
       (should-not (string-match-p "^YOU\\|^PET" (buffer-string))))
     (goto-char (point-min))
     (search-forward "## Heading")
     (should (equal (elpet-chat-test--label-at (- (point) 10)) " PET 01"))
     (when (derived-mode-p 'markdown-mode)
       (should (get-text-property (1- (point)) 'face)))
     (should (equal (elpet-chat-test--label-at elpet-chat--input) " YOU"))
     (should (equal elpet-chat--turns (list "Hello" reply))))))

(ert-deftest elpet-chat-minimal-chrome-keeps-input-and-keybindings ()
  (elpet-chat-test--with-session
   (should-not (string-match-p "C-c\\|Message\\|send\\|save"
                               (concat (buffer-string)
                                       (apply #'concat (elpet-chat--header-line))
                                       (prin1-to-string mode-line-format))))
   (dolist (binding '(("C-c C-c" . elpet-chat-send)
                      ("C-c RET" . elpet-chat-send)
                      ("C-c C-k" . elpet-chat-stop)
                      ("C-c C-r" . elpet-chat-retry)
                      ("C-c C-p" . elpet-chat-set-persona)
                      ("C-c C-s" . elpet-chat-save)
                      ("C-c C-v" . elpet-chat-toggle-markup)))
     (should (eq (lookup-key elpet-chat-mode-map (kbd (car binding))) (cdr binding))))
   (should (string-match-p "C-c" (substitute-command-keys
                                  (documentation 'elpet-chat-mode))))
   (let ((start (marker-position elpet-chat--input)))
     (should (equal (elpet-chat-test--label-at start) " YOU"))
     (insert "An editable draft")
     (delete-region start (point-max))
     (insert "Rewritten")
     (should (equal (elpet-chat-test--label-at start) " YOU"))
     (should (equal (elpet-chat--draft) "Rewritten"))
     (elpet-chat-send)
     (should (equal (caar calls) '("Rewritten")))
     (should (equal (elpet-chat-test--label-at elpet-chat--input) " YOU 01"))
     (elpet-chat-test--reply (car calls) "Reply")
     (should (equal (elpet-chat-test--label-at elpet-chat--input) " YOU"))
     (should (string-empty-p (elpet-chat--draft))))))

(ert-deftest elpet-chat-restored-history-is-natively-read-only ()
  (elpet-chat-test--with-session
   (let ((file (make-temp-file "elpet-readonly-" nil ".json"))
         (turns '("Saved question" "## Saved reply\n\nA **bold** answer.")))
     (unwind-protect
         (progn
           (with-temp-file file
             (insert (json-encode `((schema-version . 1) (persona . "Be concise")
                                    (turns . ,(vconcat turns)) (draft . "Draft")))))
           (elpet-chat-open file)
           (should-not calls)
           (font-lock-ensure)
           (when (derived-mode-p 'markdown-mode)
             (elpet-chat-toggle-markup)
             (font-lock-flush)
             (font-lock-ensure))
           (should-not (text-property-not-all (point-min) elpet-chat--input
                                              'read-only t))
           (should-not (get-text-property elpet-chat--input 'read-only))
           ;; Native protection must work independently of the change guard.
           (let ((before-change-functions nil))
             (goto-char (point-min))
             (should-error (insert "x") :type 'text-read-only)
             (search-forward "Saved question")
             (should-error (insert "x") :type 'text-read-only)
             (should-error (delete-region (1- (point)) (point)) :type 'text-read-only)
             (should-error (delete-region (1- elpet-chat--input) (point-max))
                           :type 'text-read-only))
           (goto-char elpet-chat--input)
           (insert "New ")
           (should (equal (elpet-chat--draft) "New Draft"))
           (delete-region elpet-chat--input (point-max))
           (font-lock-flush)
           (font-lock-ensure)
           (goto-char elpet-chat--input)
           (insert "Next question")
           (should-not (get-text-property elpet-chat--input 'read-only))
           (elpet-chat-send)
           (should (equal (caar calls) (append turns '("Next question"))))
           (elpet-chat-test--reply (car calls) "Streamed " '(:stream t))
           (elpet-chat-test--reply (car calls) "answer" '(:stream t))
           (elpet-chat-test--reply (car calls) t)
           (font-lock-ensure)
           (should-not (text-property-not-all (point-min) elpet-chat--input
                                              'read-only t))
           (goto-char elpet-chat--input)
           (insert "Still editable")
           (should (equal (elpet-chat--draft) "Still editable")))
       (delete-file file)))))

